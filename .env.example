# Copie para ".env" e preencha. O arquivo .env está no .gitignore e nunca deve ser versionado.

# Provedor padrão: google | openai | anthropic.
# Se omitido, usa o primeiro provedor que tiver chave configurada.
LLM_PROVIDER=google

# Modelo padrão do provedor escolhido (opcional).
# LLM_MODEL=gemini-flash-lite-latest

# Chave do provedor que for utilizar. O Gemini tem plano gratuito:
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Engine de leitura dos PDFs: pdfplumber | pymupdf | tesseract (opcional).
# OCR_ENGINE=pdfplumber

# Caminho do tesseract.exe, se não estiver no PATH (opcional, só para OCR).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Pasta do banco SQLite (opcional; padrão: ./storage).
# STORAGE_DIR=storage
